    "papaparse": "^5.5.3",
    "qs": "^6.16.0",
    "react": "^19.0.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.0.0",
    "react-helmet": "^6.1.0",
    "react-router-dom": "^7.14.2",
    "read-excel-file": "^9.3.10",
    "recharts": "^3.8.1",
