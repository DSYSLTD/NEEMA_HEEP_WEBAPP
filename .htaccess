# ====================================================================
# Hostinger Node.js & Apache Configuration for Neema HEEP
# ====================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Ensure HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# If using Hostinger Phusion Passenger or cPanel Node.js Selector,
# you can specify the startup file below if not automatically generated by hPanel:
# PassengerAppRoot "/home/USERNAME/domains/DOMAIN/public_html"
# PassengerStartupFile server.js
# PassengerAppType node
