    "@types/react-helmet": "^6.1.11",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^2.4.3",
    "browser-image-compression": "^2.0.2",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "js-cookie": "^3.0.5",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "libphonenumber-js": "^1.13.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
